# Cracked Alert v2 (cTrader) - Environment Variables
# Copy to /etc/cracked_alert/.env_cracked on the VPS and fill in.

TELEGRAM_BOT_TOKEN="token"

# Comma-separated Telegram chat ids allowed to command the bot.
# Anything else is silently ignored. (Find yours: send /help, check the logs.)
ALLOWED_CHAT_IDS="123456789"

# From the cTrader Open API portal (Applications -> Credentials -> View)
CTRADER_CLIENT_ID=""
CTRADER_CLIENT_SECRET=""

# Account shortcodes -> cTrader account ids (get ids from auth_setup.py)
# NOTE: the live account is deliberately named "live100k" (longer to type,
# harder to accidentally trade real money).
CTRADER_ACCOUNTS='{"5k":{"id":0,"env":"live"},"10k":{"id":0,"env":"live"},"raven":{"id":0,"env":"live"},"demo":{"id":0,"env":"demo"},"live100k":{"id":0,"env":"live"}}'

# Which account's price feed drives alerts (any configured shortcode)
PRICE_FEED_ACCOUNT="demo"

# Data directory: tokens.json + cracked.db live here.
# Defaults to /etc/cracked_alert; override for local development.
#CRACKED_DATA_DIR="/etc/cracked_alert"

# --- Alert-status endpoint (mobile alarm app) ---
# Shared secret the phone app sends as ?token= (or X-Alert-Token header).
# Leave empty to DISABLE the endpoint entirely (safe default).
# Data: GET /alert-status -> {active, since, detail}; POST /ack -> {ok}.
#ALERT_STATUS_TOKEN=""
#ALERT_STATUS_PORT="8190"
