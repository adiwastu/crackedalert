[Unit]
Description=Cracked Alert v2 (cTrader Telegram bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Wrapper picks the production venv if present, else the dev one.
ExecStart=/usr/local/bin/crackedalert-run
Restart=always
RestartSec=5
# journald picks up stdout/stderr; view with: journalctl -u cracked-bot -f

[Install]
WantedBy=multi-user.target
